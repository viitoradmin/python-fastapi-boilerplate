# =============================================================================
# FASTAPI BOILERPLATE - ENVIRONMENT CONFIGURATION EXAMPLE
# =============================================================================
# Copy this file to .env and update the values according to your environment
# This file serves as a template for all environment configurations

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_HOST=localhost
SERVER_PORT=8008
BASE_URL=http://localhost:8008

# Environment type (local, dev, prod)
ENV=local

# Debug mode (true/false)
DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MySQL Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=fastapi_boilerplate_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_ECHO=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Secret Key (Generate a secure random key for production)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Security
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# =============================================================================
# API KEY CONFIGURATION
# =============================================================================
# API Key Settings
API_KEY_DEFAULT_RATE_LIMIT=1000
API_KEY_DEFAULT_EXPIRY_DAYS=365
API_KEY_MAX_KEYS_PER_USER=10
API_KEY_CLEANUP_INTERVAL_HOURS=24

# Rate Limiting (for Redis-based rate limiting in production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limiting configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=10

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/app.log
LOG_ROTATION_SIZE=10MB
LOG_RETENTION_DAYS=30

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
# SMTP Settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
SMTP_SSL=false
EMAIL_FROM=noreply@yourapp.com
EMAIL_FROM_NAME=Your App Name

# =============================================================================
# REDIS CONFIGURATION (Optional - for caching/sessions)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# =============================================================================
# FILE STORAGE CONFIGURATION (Optional)
# =============================================================================
# File upload settings
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx
UPLOAD_PATH=uploads/
STATIC_FILES_PATH=static/

# =============================================================================
# EXTERNAL API KEYS (Optional)
# =============================================================================
# Third-party service API keys
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# =============================================================================
# MONITORING & ANALYTICS (Optional)
# =============================================================================
# Application monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
# Enable/disable features
FEATURE_USER_REGISTRATION=true
FEATURE_EMAIL_VERIFICATION=false
FEATURE_PASSWORD_RESET=true
FEATURE_SOCIAL_LOGIN=false
FEATURE_TWO_FACTOR_AUTH=false

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Application performance tuning
WORKER_PROCESSES=1
WORKER_CONNECTIONS=1000
KEEPALIVE_TIMEOUT=5
MAX_REQUESTS_PER_WORKER=1000
PRELOAD_APP=false

# =============================================================================
# SECURITY HEADERS
# =============================================================================
# Security middleware settings
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CONTENT_SECURITY_POLICY=default-src 'self'
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff