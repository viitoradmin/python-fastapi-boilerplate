# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# Configuration for local development environment
# Copy this to local.env and modify as needed

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_HOST=localhost
SERVER_PORT=9000
BASE_URL=http://localhost:9000

# Environment settings
ENV=local
DEBUG=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Local MySQL Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=boilerplate_db_local

# Connection Pool Settings (smaller for local dev)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_ECHO=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Settings (use simple keys for local development)
JWT_SECRET_KEY=local-development-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Password Security (relaxed for local dev)
PASSWORD_MIN_LENGTH=6
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_NUMBERS=false
PASSWORD_REQUIRE_SPECIAL_CHARS=false

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allow all origins for local development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# =============================================================================
# RATE LIMITING
# =============================================================================
# Disabled or very permissive for local development
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_BURST_SIZE=100

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=DEBUG
LOG_FORMAT=text
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/local.log

# =============================================================================
# EMAIL CONFIGURATION (Optional - use test settings)
# =============================================================================
# Use local SMTP server or disable email for local dev
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false
EMAIL_FROM=dev@localhost
EMAIL_FROM_NAME=Local Dev Server

# =============================================================================
# REDIS CONFIGURATION (Optional)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_SSL=false

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,txt,csv
UPLOAD_PATH=uploads/local/
STATIC_FILES_PATH=static/

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable all features for local testing
FEATURE_USER_REGISTRATION=true
FEATURE_EMAIL_VERIFICATION=false
FEATURE_PASSWORD_RESET=true
FEATURE_SOCIAL_LOGIN=false
FEATURE_TWO_FACTOR_AUTH=false

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
WORKER_PROCESSES=1
WORKER_CONNECTIONS=100
KEEPALIVE_TIMEOUT=5
MAX_REQUESTS_PER_WORKER=0
PRELOAD_APP=false

# =============================================================================
# SECURITY HEADERS
# =============================================================================
# Relaxed security for local development
SECURITY_HEADERS_ENABLED=false
HSTS_MAX_AGE=0
CONTENT_SECURITY_POLICY=
X_FRAME_OPTIONS=
X_CONTENT_TYPE_OPTIONS=