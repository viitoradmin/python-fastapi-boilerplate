# =============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# Configuration for development/staging environment
# Copy this to dev.env and modify as needed

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=7000
BASE_URL=https://dev-api.yourapp.com

# Environment settings
ENV=dev
DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Development Database Settings
DB_HOST=dev-db.yourapp.com
DB_PORT=3306
DB_USER=dev_user
DB_PASSWORD=secure_dev_password_here
DB_NAME=boilerplate_db_dev

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_ECHO=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Settings (use secure keys for dev environment)
JWT_SECRET_KEY=dev-environment-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Security
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=false

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Specific origins for development environment
CORS_ORIGINS=https://dev.yourapp.com,https://staging.yourapp.com,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# =============================================================================
# RATE LIMITING
# =============================================================================
# Moderate rate limiting for development
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=200
RATE_LIMIT_BURST_SIZE=20

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/dev.log
LOG_ROTATION_SIZE=10MB
LOG_RETENTION_DAYS=7

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Development SMTP settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
SMTP_TLS=true
SMTP_SSL=false
EMAIL_FROM=noreply@dev.yourapp.com
EMAIL_FROM_NAME=Your App Dev

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=dev-redis.yourapp.com
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_password
REDIS_DB=0
REDIS_SSL=true

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx
UPLOAD_PATH=uploads/dev/
STATIC_FILES_PATH=static/

# =============================================================================
# EXTERNAL API KEYS (Development/Test Keys)
# =============================================================================
GOOGLE_CLIENT_ID=your-dev-google-client-id
GOOGLE_CLIENT_SECRET=your-dev-google-client-secret
STRIPE_PUBLIC_KEY=pk_test_your-dev-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-dev-stripe-secret-key
AWS_ACCESS_KEY_ID=your-dev-aws-access-key
AWS_SECRET_ACCESS_KEY=your-dev-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-dev-s3-bucket

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
SENTRY_DSN=https://your-dev-sentry-dsn@sentry.io/project-id
ANALYTICS_ENABLED=true
GOOGLE_ANALYTICS_ID=GA-DEV-XXXXXXXXX

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable most features for development testing
FEATURE_USER_REGISTRATION=true
FEATURE_EMAIL_VERIFICATION=true
FEATURE_PASSWORD_RESET=true
FEATURE_SOCIAL_LOGIN=true
FEATURE_TWO_FACTOR_AUTH=false

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
WORKER_PROCESSES=2
WORKER_CONNECTIONS=500
KEEPALIVE_TIMEOUT=5
MAX_REQUESTS_PER_WORKER=1000
PRELOAD_APP=false

# =============================================================================
# SECURITY HEADERS
# =============================================================================
# Moderate security for development
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=3600
CONTENT_SECURITY_POLICY=default-src 'self' 'unsafe-inline' 'unsafe-eval'
X_FRAME_OPTIONS=SAMEORIGIN
X_CONTENT_TYPE_OPTIONS=nosniff