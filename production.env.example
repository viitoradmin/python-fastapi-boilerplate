# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Configuration for production environment
# Copy this to production.env and modify as needed
# IMPORTANT: Use secure values and never commit actual production secrets!

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
BASE_URL=https://api.yourapp.com

# Environment settings
ENV=prod
DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Production Database Settings
DB_HOST=prod-db.yourapp.com
DB_PORT=3306
DB_USER=prod_user
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PRODUCTION_PASSWORD
DB_NAME=boilerplate_db_prod

# Connection Pool Settings (optimized for production)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_PRE_PING=true
DB_ECHO=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Settings (MUST use secure random keys in production)
JWT_SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_KEY_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Security (strict for production)
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Strict CORS for production
CORS_ORIGINS=https://yourapp.com,https://www.yourapp.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With

# =============================================================================
# RATE LIMITING
# =============================================================================
# Strict rate limiting for production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=5

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=WARNING
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/prod.log
LOG_ROTATION_SIZE=50MB
LOG_RETENTION_DAYS=90

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Production SMTP settings
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SENDGRID_API_KEY
SMTP_TLS=true
SMTP_SSL=false
EMAIL_FROM=noreply@yourapp.com
EMAIL_FROM_NAME=Your App

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=prod-redis.yourapp.com
REDIS_PORT=6379
REDIS_PASSWORD=SECURE_REDIS_PASSWORD_HERE
REDIS_DB=0
REDIS_SSL=true

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf
UPLOAD_PATH=s3://your-prod-bucket/uploads/
STATIC_FILES_PATH=s3://your-prod-bucket/static/

# =============================================================================
# EXTERNAL API KEYS (Production Keys)
# =============================================================================
GOOGLE_CLIENT_ID=your-prod-google-client-id
GOOGLE_CLIENT_SECRET=YOUR_PROD_GOOGLE_CLIENT_SECRET
STRIPE_PUBLIC_KEY=pk_live_your-prod-stripe-public-key
STRIPE_SECRET_KEY=sk_live_YOUR_PROD_STRIPE_SECRET_KEY
AWS_ACCESS_KEY_ID=YOUR_PROD_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_PROD_AWS_SECRET_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-prod-s3-bucket

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
SENTRY_DSN=https://your-prod-sentry-dsn@sentry.io/project-id
ANALYTICS_ENABLED=true
GOOGLE_ANALYTICS_ID=GA-PROD-XXXXXXXXX

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Production feature configuration
FEATURE_USER_REGISTRATION=true
FEATURE_EMAIL_VERIFICATION=true
FEATURE_PASSWORD_RESET=true
FEATURE_SOCIAL_LOGIN=true
FEATURE_TWO_FACTOR_AUTH=true

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Optimized for production load
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1000
KEEPALIVE_TIMEOUT=2
MAX_REQUESTS_PER_WORKER=10000
PRELOAD_APP=true

# =============================================================================
# SECURITY HEADERS
# =============================================================================
# Strict security headers for production
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================
# SSL settings for production
SSL_ENABLED=true
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem
SSL_CA_CERTS_PATH=/path/to/ssl/ca-certs.pem

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Database backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-s3-bucket
BACKUP_ENCRYPTION_KEY=YOUR_BACKUP_ENCRYPTION_KEY

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
# Health monitoring settings
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3